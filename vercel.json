{
    "version": 2,
    "builds": [
        {
            "src": "index.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "dashboard.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "auth/*.php",
            "use": "vercel-php@0.7.2"
        },
        {
            "src": "tasks/*.php",
            "use": "vercel-php@0.7.2"
        }
    ],
    "routes": [
        {
            "handle": "filesystem"
        },
        {
            "src": "^/$",
            "dest": "/index.php"
        },
        {
            "src": "^/dashboard$",
            "dest": "/dashboard.php"
        },
        {
            "src": "^/auth/login$",
            "dest": "/auth/login.php"
        },
        {
            "src": "^/auth/logout$",
            "dest": "/auth/logout.php"
        },
        {
            "src": "^/auth/register$",
            "dest": "/auth/register.php"
        },
        {
            "src": "^/tasks/add$",
            "dest": "/tasks/add.php"
        },
        {
            "src": "^/tasks/delete$",
            "dest": "/tasks/delete.php"
        },
        {
            "src": "^/tasks/toggle$",
            "dest": "/tasks/toggle.php"
        }
    ]
}